# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

PORT=3001

# From https://docs.tcgplayer.com — requires partner approval, not instant self-serve.
TCGPLAYER_CLIENT_ID=your_tcgplayer_public_key
TCGPLAYER_CLIENT_SECRET=your_tcgplayer_private_key

# From https://developer.ebay.com — free self-serve signup, instant for sandbox,
# production keys require a short review.
EBAY_CLIENT_ID=your_ebay_app_id
EBAY_CLIENT_SECRET=your_ebay_cert_id
# "sandbox" for testing against fake data, "production" for real listings.
EBAY_ENV=sandbox

# Comma-separated list of origins allowed to call this server (your CardDesk
# page's URL once it's hosted). Use * only while testing locally.
ALLOWED_ORIGINS=*
